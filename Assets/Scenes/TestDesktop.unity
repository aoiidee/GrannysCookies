  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e27f2ef59720db4469ffa709ed0d5137, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GrannyText
  grannyDialogue:
  - "Go ahead and type in my password right there. I keep it on a little sticky note
    so I don\u2019t forget it. I would do it myself, but my arthritis has been acting
    up lately\u2026 "
  - My sweet little niece is good with this stuff, should have sent me something
    we can use to fix this. She mentioned something about an email? Is that in the
    mailbox?
  - "So, she says I have to \u201Cinstall a program\u201D? I have plenty of programs
    I like to watch on television, but what does that have to do with this newfangled
    computer? "
  - "Goodness gracious! More of those popups. It\u2019s been nonstop! They\u2019ve
    been giving me a harder time than expired taffy. Why don\u2019t you see if you
    can do something about it, dear? "
  - 'Look at that pesky little virus trying to stop you! Beat it like I do all the
    ladies at Gin Rummy! '
  - "Wow, this virus is really persistent! Like Lucifer when he\u2019s begging for
    treats\u2026 That cat is getting too fat\u2026 "
  - "Go away, viruses. Shoo! You can\u2019t have my computer!"
  - "BINGO! The Defender thing actually worked! That better be the last time I have
    to deal with those stupid things! Oh, thank you so much, sweetie. Please, take
    a cookie, I think you\u2019ve earned it! "
  dialogueBox: {fileID: 1146306479}
  dialogeButton: {fileID: 251105892}
  blur: {fileID: 562823969}
  grannyImage: {fileID: 221833931}
  textShown: {fileID: 261973251}
  textSpeed: 0.01
  textDelay: 3
  index: 0
  dialogueActive: 0
  _anim: {fileID: 221833928}
